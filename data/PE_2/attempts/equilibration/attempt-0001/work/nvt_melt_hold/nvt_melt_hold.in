# ============================================================
# PolyJarvis LAMMPS Engine - NVT Simulation Template
# ============================================================
# Stage: NVT (constant volume, constant temperature)
# Use cases:
#   - Initial heating to melt temperature
#   - Constant-T annealing step
#   - Production run at fixed density (after NPT equilibration)
#   - Temperature ramp up or down
#
# Tunable parameters (injected by script_generator.py):
#   DATA_FILE        - .data or .restart file to read
#   READ_COMMAND     - "read_data" or "read_restart"
#   LOG_FILE         - log filename
#   LOG_APPEND       - "append" or "" (overwrite)
#   DUMP_FILE        - trajectory filename
#   LAST_DUMP_FILE   - final snapshot filename
#   WRITE_DATA_FILE  - output .data filename
#   WRITE_RESTART_FILE - unconditional final-state restart file, written every run
#                        (independent of periodic RESTART_BLOCK checkpointing) so a
#                        continuation call always has a definitive state to read from
#   DUMP_APPEND_BLOCK - "dump_modify dump_nvt append yes" or empty -- set when this
#                        run continues (via READ_COMMAND=read_restart) a trajectory
#                        started by an earlier run into the SAME DUMP_FILE/LOG_FILE
#   RESTART_FILE_1   - restart checkpoint file 1
#   RESTART_FILE_2   - restart checkpoint file 2
#   RESTART_FREQ     - steps between restart writes
#   RESTART_BLOCK    - full restart command or empty
#   PAIR_STYLE_BLOCK - pair + kspace style lines
#   BOND_STYLE, ANGLE_STYLE, DIHEDRAL_STYLE, IMPROPER_STYLE
#   GPU_PACKAGE      - "package gpu 1 neigh no" or empty
#   T_START          - initial temperature (K)
#   T_FINAL          - final temperature (K) -- ramp or constant
#   T_DAMP           - thermostat damping (fs), recommended 100*timestep
#   TIMESTEP         - integration timestep (fs), typically 1.0
#   N_STEPS          - number of MD steps
#   THERMO_FREQ      - thermo output frequency (steps)
#   DUMP_FREQ        - dump output frequency (steps)
#   SHAKE_BLOCK      - "fix shake..." or empty
#   UNSHAKE_BLOCK    - "unfix shake..." or empty
#   INIT_VELOCITY_BLOCK - "velocity all create..." or empty
# ============================================================

log nvt_melt_hold.log 
units real
atom_style full
boundary p p p

# --- Force Field Styles ---
pair_style lj/cut 14.0
dielectric 1.000000
bond_style harmonic
angle_style harmonic
dihedral_style multi/harmonic
improper_style none
special_bonds lj 0 0 0
pair_modify mix arithmetic tail yes
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
neigh_modify one 4000
package gpu 1 neigh yes

read_data /home/alexzhao/PolyJarvis/data/PE_2/attempts/equilibration/attempt-0001/work/npt_melt_ramp/npt_melt_ramp_out.data
include /home/alexzhao/PolyJarvis/data/PE_2/attempts/build/attempt-0001/work/cell/emc_build.params

# --- Thermo Output ---
thermo_style custom step time temp press enthalpy etotal ke pe ebond eangle edihed eimp evdwl ecoul elong etail vol lx ly lz density pxx pyy pzz
thermo_modify flush yes
thermo 1000

# --- Trajectory ---
dump dump_nvt all custom 1000 nvt_melt_hold.dump id type mol x y z ix iy iz vx vy vz


# --- Restart Checkpointing ---
restart 10000 nvt_1.rst nvt_2.rst

# --- Initial Velocities (optional) ---
# Velocities read from data file

# --- SHAKE Constraints ---
# Constrains H-X bonds to allow 2fs timestep
# SHAKE disabled (TraPPE-UA united-atom)

# --- NVT Thermostat (Nose-Hoover) ---
# T_damp = 100.0 fs  (coupling timescale for heat exchange)
# Ramp: 550.0 K -> 550.0 K over 2500000 steps
timestep 2.0
fix nvt_fix all nvt temp 550.0 550.0 100.0

run 2500000

# --- Cleanup ---
unfix nvt_fix

undump dump_nvt

# --- Write Output ---
write_dump all custom nvt_melt_hold_last.dump id type mol x y z xu yu zu vx vy vz modify sort id
write_data /home/alexzhao/PolyJarvis/data/PE_2/attempts/equilibration/attempt-0001/work/nvt_melt_hold/nvt_melt_hold_out.data
write_restart /home/alexzhao/PolyJarvis/data/PE_2/attempts/equilibration/attempt-0001/work/nvt_melt_hold/nvt_melt_hold_out.restart

print "STAGE COMPLETE: NVT T=550.0->550.0K steps=2500000"
quit

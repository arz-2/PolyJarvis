# --- Thermo Output ---
thermo_style custom step time temp press enthalpy etotal ke pe ebond eangle edihed eimp evdwl ecoul elong etail vol lx ly lz density pxx pyy pzz
thermo_modify flush yes
thermo 1000

# --- Trajectory ---
dump dump_nvt all custom 1000 anneal_heat.dump id type mol x y z ix iy iz vx vy vz


# --- Restart Checkpointing ---
restart 10000 nvt_1.rst nvt_2.rst

# --- Initial Velocities (optional) ---
# Velocities read from data file

# --- SHAKE Constraints ---
# Constrains H-X bonds to allow 2fs timestep
# SHAKE disabled

# --- NVT Thermostat (Nose-Hoover) ---
# T_damp = 100.0 fs  (coupling timescale for heat exchange)
# Ramp: 300.0 K -> 630.0 K over 500000 steps
timestep 1.0
fix nvt_fix all nvt temp 300.0 630.0 100.0

run 500000

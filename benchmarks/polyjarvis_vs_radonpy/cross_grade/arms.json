{
  "system": "PEG1",
  "smiles": "*CCO*",
  "graded_at_K": 300,
  "windows": {
    "native": {"width": 2000, "tail_rows": null,
               "why": "RadonPy's own default: width=2000 thermo rows on the full sampling log."},
    "matched": {"width": 800, "tail_rows": 2001,
                "why": "Both arms truncated to their last 2001 rows (2 ns at 1 row/ps), width 800 = the same 40% of the window RadonPy's 2000/5001 uses. PolyJarvis production logs hold 2001 rows, where width 2000 leaves every sma_sd NaN and check_eq passes vacuously. A shorter rolling mean fluctuates more, so the matched window is stricter than native on BOTH arms equally."}
  },
  "path_roots": {
    "repo:": "this checkout",
    "v1:": "$POLYJARVIS_V1_ROOT, default ~/PolyJarvis -- the round-1 checkout that holds the PEG runs"
  },

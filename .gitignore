# ── Claude Code (machine-specific, use .mcp.json.example as template) ─────────
.mcp.json
.claude/settings.local.json
# understand-anything knowledge graph — machine-local, rebuildable via /understand
.understand-anything/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.env
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
.python-version
.pytest_cache/
.venv/

# ── Runtime state (not source) ────────────────────────────────────────────────
mcp-servers/mcp-lammps-engine/run_state.json
timer.dat
# generated by `python -m tools.runlog_miner --playbook`; consulted locally by /recover
guides/RECOVERY_PLAYBOOK.md

# ── Simulation data and experiment database (local only) ──────────────────────
data/*
!data/TEMPLATE/
# the sqlite payload is curated from copyrighted sources (Polymer Handbook, MatWeb) and stays
# local; the schema + query/ingest code is tracked so a clone can rebuild it
db/experimental_db.sqlite
# PolyDatabase (polydatabase.com) MD-simulation-literature index, rebuilt locally from the
# public CC-BY Zenodo dataset via db/ingest_scripts/import_polydatabase.py — gitignored for
# size/rebuildability, not copyright; schema + ingest/query code is tracked
db/polydatabase_md.sqlite

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Simulation outputs (large, not source) ────────────────────────────────────
*.dump
*.data
*.restart
*.xtc
*.dcd
*.log

# ── Manuscript & internal planning docs (not for public repo) ─
literature/
# manuscript/: the paper sources stay local until acceptance. The generators and the small
# processed-data outputs are tracked, because every reported number derives from them. Bulk
# regenerable intermediates are not -- gen/out/chains/ and gen/out/tg_reextract/ rebuild from data/.
manuscript/*
!manuscript/gen/
manuscript/gen/out/chains/
manuscript/gen/out/tg_reextract/
manuscript/**/__pycache__/
!manuscript/replot_from_tool.py
docs/LLM_CONTRIBUTION_PLAN.md
docs/UI_PLAN.md
guides/TODO_OWNER.md
guides/ROADMAP.md
guides/REVISION_PARAMS.md

# ── Machine-specific hardware docs (benchmarks/policy for this box only) ──────
hardware/HARDWARE.md
hardware/HARDWARE_STUDY.md

# ── Committed calibration-cell payload (must come last to win over *.data/*.log above) ──
# Calibration cells (hardware/CALIB_<FAM>/) ship the small emc_build.{data,params} per FF so a
# fresh clone can host-match engine defaults via /calibrate-hardware without an EMC build.
# Only those two files per cell are committed; every other artifact in the dir stays local.
hardware/CALIB_*/*
!hardware/CALIB_*/emc_build.data
!hardware/CALIB_*/emc_build.params

# ── Benchmark run artifacts (benchmarks/<suite>/data/) ───────────────────────
# The comparison harness under benchmarks/ is source worth committing; the runs it
# produces are not -- one PEG1 RadonPy run alone leaves 24 GB (14 files over GitHub's
# 100 MB hard limit) of dumps, ESP grids, pickles and per-thermo plots.
benchmarks/*/data/

# Launcher PID files written by background campaign runs
*.pid

# Runtime lock files (filelock on the characterization cache)
*.json.lock

# Superseded RadonPy PEG comparison runs (40 MB); the reported external reference is the PTFE arm.
benchmarks/polyjarvis_vs_radonpy/preserved_artifacts/
# Controlled bulk-modulus legs: the code is tracked, its run outputs and logs are not.
benchmarks/bm_diagnostics_r2/results/
benchmarks/bm_diagnostics_r2/__pycache__/
benchmarks/bm_diagnostics_r2/*.log
benchmarks/bm_diagnostics_r2/*.pid

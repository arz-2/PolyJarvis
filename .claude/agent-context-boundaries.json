{
  "_comment": "Per-subagent read/Bash boundary config for PolyJarvis. Consumed by .claude/hooks/agent_context_boundary.py. Paths are repo-relative unless prefixed 'abs:'. A '/**' suffix means directory-prefix match; no suffix means exact file. {agent} is substituted with the calling agent_type at runtime.",

  "enforce_write": false,
  "_enforce_write_note": "Read-only enforcement (Read/Grep/Glob/Bash) ships first. Flip to true only after extending the settings.json hook matcher to include Write|Edit. write_allow lists below are pre-populated so that flip is a one-line settings.json change.",

  "baseline_allow": [
    "data/**",
    ".claude/agent-memory/{agent}/**"
  ],

  "deny_dirs": [
    ".claude/agents/**",
    ".claude/hooks/**",
    ".claude/settings.json",
    ".claude/settings.local.json",
    ".claude/agent-memory/**",
    ".claude/commands/**",
    "mcp-servers/**",
    "orchestration/tracks/**",
    "orchestration/scripts/**",
    "orchestration/decision_policy.json",
    "orchestration/ORCHESTRATOR.md",
    "orchestration/README.md",
    "guides/**",
    "db/**",
    "manuscript/**",
    "manuscript_v2/**",
    "docs/**",
    "hardware/**",
    "tools/**",
    "tests/**",
    "literature/**",
    ".understand-anything/**",
    ".git/**",
    ".github/**",
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "Task_TEMPLATE.txt",
    "LICENSE",
    ".env",
    ".mcp.json",
    ".mcp.json.example",
    "pytest.ini",
    "requirements-test.txt"
  ],

  "default_unknown_agent": {
    "extra_read_allow": [],
    "bash_allow": [],
    "write_allow": []
  },

  "agents": {
    "bulk-modulus-extractor": {
      "extra_read_allow": [],
      "bash_allow": [],
      "write_allow": ["data/**"]
    },
    "critic": {
      "extra_read_allow": [
        "orchestration/decision_policy.json",
        "guides/system_characterization_cache.json"
      ],
      "bash_allow": [
        "orchestration/scripts/canon_smiles.py",
        "orchestration/scripts/validate_run_plan.py"
      ],
      "write_allow": ["data/**"]
    },
    "deform-worker": {
      "extra_read_allow": [],
      "bash_allow": [],
      "write_allow": []
    },
    "equilibration-checker": {
      "extra_read_allow": [],
      "bash_allow": [],
      "write_allow": ["data/**"]
    },
    "equilibration-worker": {
      "extra_read_allow": [],
      "bash_allow": [],
      "write_allow": ["data/**"]
    },
    "exp-lookup-worker": {
      "extra_read_allow": [],
      "bash_allow": [
        "db/query_best_match.py"
      ],
      "write_allow": ["data/**"]
    },
    "literature-grounding-worker": {
      "extra_read_allow": [
        "guides/polymer_rules.json"
      ],
      "bash_allow": [],
      "write_allow": ["data/**", "guides/polymer_rules.json"]
    },
    "molecule-builder": {
      "extra_read_allow": [
        "abs:/home/arz2/polyjarvis_emc_jobs/**"
      ],
      "bash_allow": [
        "abs:/home/arz2/polyjarvis_emc_jobs/**"
      ],
      "write_allow": ["data/**"]
    },
    "murnaghan-worker": {
      "extra_read_allow": [],
      "bash_allow": [],
      "write_allow": ["data/**"]
    },
    "planner": {
      "extra_read_allow": [
        "orchestration/decision_policy.json",
        "guides/polymer_rules.json",
        "guides/system_characterization_cache.json"
      ],
      "bash_allow": [
        "orchestration/scripts/canon_smiles.py",
        "orchestration/scripts/validate_run_plan.py",
        "orchestration/scripts/make_deterministic_plan.py",
        "orchestration/scripts/estimate_tg_group_contribution.py",
        "orchestration/scripts/select_hardware.py"
      ],
      "write_allow": ["data/**"]
    },
    "protocol-locker": {
      "extra_read_allow": [
        "guides/polymer_rules.json",
        "guides/system_characterization_cache.json"
      ],
      "bash_allow": [
        "orchestration/scripts/canon_smiles.py",
        "orchestration/scripts/make_deterministic_plan.py"
      ],
      "write_allow": [
        "data/**",
        "guides/polymer_rules.json",
        "guides/system_characterization_cache.json"
      ]
    },
    "recovery-agent": {
      "extra_read_allow": [
        ".claude/commands/recover.md"
      ],
      "bash_allow": [],
      "write_allow": []
    },
    "run-summary-worker": {
      "extra_read_allow": [],
      "bash_allow": [],
      "write_allow": []
    },
    "system-characterization-analyzer": {
      "extra_read_allow": [
        "guides/polymer_rules.json"
      ],
      "bash_allow": [],
      "write_allow": ["data/**", "guides/system_characterization_cache.json"]
    },
    "tg-analysis-worker": {
      "extra_read_allow": [],
      "bash_allow": [
        "mcp-servers/mcp-lammps-engine/analysis_scripts/extract_tg_multirate.py"
      ],
      "write_allow": ["data/**"]
    },
    "tg-sweep-worker": {
      "extra_read_allow": [],
      "bash_allow": [],
      "write_allow": ["data/**"]
    }
  }
}
